// pnpm eval 的固定考卷。evals/run.ts 逐条把 input 当成用户的一句话，
// 用 workbench 那套 tools 跑一轮，再按 expect 判分。
// 脚本不看模型写出的句子，只看 toolCalls，以及 validateFields 的返回值、exportLocaleSnippet 的入参。
//
// 一条 case：
//   id        题号，只打在日志里。
//   category  题型标签，只打在日志里。四类见下方。
//   input     发给模型的那一句英文。
//   expect    标准答案。脚本只读下面 5 个字段。
//
// expect：
//   tools_include      这些 tool 都必须出现（多调可以，少一个记 tool_miss）。
//                      工具选对率的分母 = 写了 tools_include 的题。
//   trigger_type_code  这题心里想的 trigger code，只给读卷的人看。
//                      脚本不拿它和模型传入的 code 比较。
//   validate_ok        true 或 false。对比本轮最后一次 validateFields 的 ok。
//                      没调到 validateFields 也记 validate_mismatch。
//                      没写这个字段的题，不进校验通过率的分母。
//   missing_fields     仅当本题写了 validate_ok 时才检查。
//                      最后一次 validateFields 的 missing 要包含这里每个字段名，
//                      缺一个记一条 missing_mismatch。
//   locales            exportLocaleSnippet 的入参 locale 要覆盖这里每个值，
//                      缺一个记 locale_miss。
//
// 同一题可以同时有多种失败。
// 日志里 FAIL 后面的词是脚本自己记的失败类型，不是模型写出的句子：
//   tool_miss          tools_include 里的某个 tool 这轮一次都没出现。
//   validate_mismatch  写了 validate_ok，但最后一次 validateFields 的 ok 和它不相等。
//                      没调到 validateFields 也记这一条。
//   missing_mismatch   写了 missing_fields，但最后一次 validateFields 的 missing 里没有这个字段名。
//                      每缺一个字段记一条。
//   locale_miss        locales 里的某个 locale 没有出现在 exportLocaleSnippet 的入参里。
//   error              这题跑的时候抛错，后面的检查没做成。
//
// category：
//   tool_choice    这句话该调到列出的 tool。
//   missing_field  故意少填。validate_ok 为 false，且 missing 里要有列出的字段。
//   locale_export  必须调 exportLocaleSnippet，并带上列出的 locale。
//   bad_trigger    错误或不存在的 code。
//                  tools_include 为 getCopySchema 时，未知 code 由 schema 结果表达，不写 validate_ok。
//                  用户明确说 Validate 时才要求 validateFields，且 validate_ok 为 false。
[
  {
    "id": "tc-01",
    "category": "tool_choice",
    "input": "What notification types are available?",
    "expect": { "tools_include": ["listTriggerTypes"] }
  },
  {
    "id": "tc-02",
    "category": "tool_choice",
    "input": "Which fields are required for a bounty rejection notification?",
    "expect": {
      "tools_include": ["getCopySchema"],
      "trigger_type_code": "bounty_review_rejected"
    }
  },
  {
    "id": "tc-03",
    "category": "tool_choice",
    "input": "Write a bounty rejection notice. Design name is Desktop Organizer Box, reason is unclear toolpath. Please redesign.",
    "expect": {
      "tools_include": ["validateFields"],
      "trigger_type_code": "bounty_review_rejected",
      "validate_ok": true
    }
  },
  {
    "id": "tc-04",
    "category": "tool_choice",
    "input": "Write a bounty approval notice. Design name is Desktop Organizer Box, target count is 3.",
    "expect": {
      "tools_include": ["validateFields"],
      "trigger_type_code": "bounty_review_approved",
      "validate_ok": true
    }
  },
  {
    "id": "tc-05",
    "category": "tool_choice",
    "input": "Write an official announcement. Title is Weekend maintenance, summary is site pause Sunday 2–4pm.",
    "expect": {
      "tools_include": ["validateFields"],
      "trigger_type_code": "announcement_published",
      "validate_ok": true
    }
  },
  {
    "id": "tc-06",
    "category": "tool_choice",
    "input": "Publish the bounty rejection copy we just drafted.",
    "expect": {
      "tools_include": ["publishCopy"]
    }
  },
  {
    "id": "mf-01",
    "category": "missing_field",
    "input": "Write a bounty rejection notice. Design name is Desktop Organizer Box.",
    "expect": {
      "tools_include": ["validateFields"],
      "trigger_type_code": "bounty_review_rejected",
      "validate_ok": false,
      "missing_fields": ["reject_reason"]
    }
  },
  {
    "id": "mf-02",
    "category": "missing_field",
    "input": "Write a bounty rejection notice. Reason is unclear toolpath.",
    "expect": {
      "tools_include": ["validateFields"],
      "trigger_type_code": "bounty_review_rejected",
      "validate_ok": false,
      "missing_fields": ["design_name"]
    }
  },
  {
    "id": "mf-03",
    "category": "missing_field",
    "input": "Write a bounty approval notice. Design name is Desktop Organizer Box.",
    "expect": {
      "tools_include": ["validateFields"],
      "trigger_type_code": "bounty_review_approved",
      "validate_ok": false,
      "missing_fields": ["target_count"]
    }
  },
  {
    "id": "mf-04",
    "category": "missing_field",
    "input": "Write an official announcement. Title is Weekend maintenance.",
    "expect": {
      "tools_include": ["validateFields"],
      "trigger_type_code": "announcement_published",
      "validate_ok": false,
      "missing_fields": ["announcement_summary"]
    }
  },
  {
    "id": "mf-05",
    "category": "missing_field",
    "input": "Write an official announcement. Summary is weekend access pause.",
    "expect": {
      "tools_include": ["validateFields"],
      "trigger_type_code": "announcement_published",
      "validate_ok": false,
      "missing_fields": ["announcement_title"]
    }
  },
  {
    "id": "ex-01",
    "category": "locale_export",
    "input": "Write a bounty rejection notice. Design name is Desktop Organizer Box, reason is unclear toolpath. Then export locale.",
    "expect": {
      "tools_include": ["exportLocaleSnippet"],
      "trigger_type_code": "bounty_review_rejected",
      "locales": ["zh-CN", "en-US"]
    }
  },
  {
    "id": "ex-02",
    "category": "locale_export",
    "input": "Write a bounty approval notice. Design name is Desktop Organizer Box, target count is 3. Then export locale.",
    "expect": {
      "tools_include": ["exportLocaleSnippet"],
      "trigger_type_code": "bounty_review_approved",
      "locales": ["zh-CN", "en-US"]
    }
  },
  {
    "id": "ex-03",
    "category": "locale_export",
    "input": "Write an official announcement. Title is Weekend maintenance, summary is site pause Sunday 2–4pm. Then export locale.",
    "expect": {
      "tools_include": ["exportLocaleSnippet"],
      "trigger_type_code": "announcement_published",
      "locales": ["zh-CN", "en-US"]
    }
  },
  {
    "id": "ex-04",
    "category": "locale_export",
    "input": "Bounty rejection: design name Desk Lamp, reason wrong size. Export en-US snippet only.",
    "expect": {
      "tools_include": ["exportLocaleSnippet"],
      "trigger_type_code": "bounty_review_rejected",
      "locales": ["en-US"]
    }
  },
  {
    "id": "ex-05",
    "category": "locale_export",
    "input": "Official announcement: title New feature launch, summary batch export supported. Preview first, then export zh-CN.",
    "expect": {
      "tools_include": ["previewNotification", "exportLocaleSnippet"],
      "trigger_type_code": "announcement_published",
      "locales": ["zh-CN"]
    }
  },
  {
    "id": "bt-01",
    "category": "bad_trigger",
    "input": "Write a notification for bounty_review_unknown. Design name is Table.",
    "expect": {
      "tools_include": ["getCopySchema"],
      "trigger_type_code": "bounty_review_unknown"
    }
  },
  {
    "id": "bt-02",
    "category": "bad_trigger",
    "input": "Validate trigger bounty_review_reject with design name Table and reason unclear toolpath.",
    "expect": {
      "tools_include": ["validateFields"],
      "trigger_type_code": "bounty_review_reject",
      "validate_ok": false
    }
  },
  {
    "id": "bt-03",
    "category": "bad_trigger",
    "input": "Which fields does bounty_awarded need?",
    "expect": {
      "tools_include": ["getCopySchema"],
      "trigger_type_code": "bounty_awarded"
    }
  },
  {
    "id": "bt-04",
    "category": "bad_trigger",
    "input": "Export locale for a non-existent type not_a_real_trigger.",
    "expect": {
      "tools_include": ["getCopySchema"],
      "trigger_type_code": "not_a_real_trigger"
    }
  }
]
